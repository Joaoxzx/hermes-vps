# crontab do usuário hermes (horário UTC: 12 UTC = 9h em Brasília)

# check semanal da VPS, toda segunda às 9h
0 12 * * 1 /home/hermes/avisos/check_semanal.sh

# sinal de "estou vivo" para o Healthchecks.io a cada 5 minutos
*/5 * * * * curl -fsS -m 10 --retry 3 -o /dev/null https://hc-ping.com/SEU-UUID-AQUI

# busca de vagas (https://github.com/Joaoxzx/buscador-de-vagas): 8h, 12h e 17h em dias úteis, 12h no fim de semana
0 11,15,20 * * 1-5 python3 /home/hermes/buscador-de-vagas/buscar_vagas.py >> /home/hermes/vagas/log.txt 2>&1
0 15 * * 0,6 python3 /home/hermes/buscador-de-vagas/buscar_vagas.py >> /home/hermes/vagas/log.txt 2>&1
